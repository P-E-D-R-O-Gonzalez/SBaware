---
import Layout from '../layouts/Layout.astro';
import Brand from '../components/Brand.astro';
import Weather from '../components/Weather.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import BackToSite from '../components/BackToSite.astro';
import { readHomepage } from '../lib/homepage';
interface Props {
  content: unknown;
  pageTitle?: string;
}
const { content, pageTitle } = Astro.props;
const homepage = readHomepage(content);
---

<Layout title={pageTitle}>
  <div id="homepage-background" class:list={{ 'mountain-background': !pageTitle }} aria-hidden="true"></div>
  <div class:list={['hub', { 'mountain-home': !pageTitle }]}>
    <header>
      {!pageTitle && <svg class="mountain-range" viewBox="0 0 1440 270" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
        <path fill="#b99a32" d="M0 180 175 112 290 143 455 64 575 135 720 50 875 139 1010 85 1210 157 1440 101V270H0Z" />
        <path fill="#7293a5" d="M0 215 170 139 302 181 465 87 580 164 727 72 875 167 1015 111 1200 186 1440 128V270H0Z" />
        <path fill="#f8faf9" d="m0 246 154-52 103 20L414 81l66 46 65-72 194 159 96-55 77 38L1064 69l184 157 83-34 109 51v27H0Z" />
        <path fill="#c7d9e2" d="m257 214 157-133-49 97 43-16-16 37 88-72-14 42 79-114-36 102 38-20 24 49-12-62 180 90-194-159-65 72-66-46Zm655-17 152-128-39 97 44-23 18 42-4-71 165 112-184-157Z" />
        <path fill="#e5edf0" d="m0 258 226-25 125 22 223-34 214 33 217-28 209 26 226-17v35H0Z" />
      </svg>}
      {pageTitle ? <><div><Brand /></div><h1>{pageTitle}</h1><BackToSite /></> : <h1><Brand /></h1>}
      <time id="date">Date</time>
      <time id="clock">Time</time>
      <Weather />
    </header>
    <main aria-label={pageTitle ? `${pageTitle} resources` : "Hub boxes"}>
      {homepage.sections.map((section, index) => {
        const panelId = `home-panel-${index}`;
        const headingId = `card-title-${index}`;
        const external = section.url.startsWith('https://');
        return (
          <section id={`box-${index + 1}`} class="box" aria-labelledby={headingId}>
            <div class="card-content">
              <h2 id={headingId}>{section.title}</h2>
              {section.description && <p class="card-description">{section.description}</p>}
              {section.type !== 'text' && <div class="card-actions">
                {section.type === 'link' ? (
                  <a class="card-action" href={section.url} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{section.button_label}</a>
                ) : (
                  <button type="button" class="load-frame" aria-controls={panelId} aria-expanded="false">{section.button_label}</button>
                )}
                {section.type === 'embed' && <a class="source-link" href={section.url} target={external ? '_blank' : undefined} rel="noopener noreferrer">Visit website <span aria-hidden="true">↗</span></a>}
              </div>}
            </div>
            {section.type === 'embed' && <iframe id={panelId} data-src={section.embed_url} data-source-title={section.panel_title} title={section.panel_title} referrerpolicy="strict-origin-when-cross-origin" hidden></iframe>}
            {section.type === 'media' && <div id={panelId} data-source-title={section.panel_title} title={section.panel_title} hidden><InstagramFeed /></div>}
          </section>
        );
      })}
    </main>
    <footer>
      <nav aria-label="Community links">
        {homepage.footer_links.map(link => <a href={link.url} target={link.url.startsWith('https://') ? '_blank' : undefined} rel="noopener noreferrer">{link.label}</a>)}
      </nav>
    </footer>
  </div>
</Layout>

<script>
  const frameButtons = document.querySelectorAll<HTMLButtonElement>('.load-frame');
  function stopPanelMedia(panel: HTMLElement) {
    panel.dispatchEvent(new CustomEvent('panel-close'));
    const frames = panel instanceof HTMLIFrameElement ? [panel] : panel.querySelectorAll('iframe');
    frames.forEach(frame => {
      // Unload cross-origin players as well as nested embeds; hiding them does not stop playback.
      frame.removeAttribute('srcdoc');
      frame.removeAttribute('src');
    });
    panel.querySelectorAll<HTMLMediaElement>('audio, video').forEach(media => media.pause());
  }
  // Preserve English source titles when the visible title changes language.
  const frameTitles = new Map<string, string>();
  document.querySelectorAll<HTMLElement>('[data-source-title]').forEach(frame => {
    frameTitles.set(frame.id, frame.dataset.sourceTitle!);
  });
  frameButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const frame = document.getElementById(button.getAttribute('aria-controls') ?? '');
      if (!(frame instanceof HTMLElement)) return;
      const title = frameTitles.get(frame.id) || frame.dataset.title || frame.title;

      const opening = frame.hidden;
      if (opening) {
        frameButtons.forEach((otherButton) => {
          if (otherButton === button) return;
          const otherFrame = document.getElementById(otherButton.getAttribute('aria-controls') ?? '');
          if (!(otherFrame instanceof HTMLElement) || otherFrame.hidden) return;
          otherFrame.hidden = true;
          stopPanelMedia(otherFrame);
          otherFrame.closest('.box')?.classList.remove('is-expanded');
          otherButton.setAttribute('aria-expanded', 'false');
          otherButton.textContent = `Open ${frameTitles.get(otherFrame.id) || otherFrame.dataset.title || otherFrame.title}`;
        });
      }
      if (opening && frame instanceof HTMLIFrameElement && !frame.hasAttribute('src') && !frame.hasAttribute('srcdoc')) {
        if (frame.dataset.srcdoc) frame.srcdoc = frame.dataset.srcdoc;
        else if (frame.dataset.src) frame.src = frame.dataset.src;
      }
      frame.hidden = !opening;
      if (!opening) stopPanelMedia(frame);
      if (opening) frame.dispatchEvent(new CustomEvent('panel-open'));
      frame.closest('.box')?.classList.toggle('is-expanded', opening);
      button.setAttribute('aria-expanded', String(opening));
      button.textContent = `${opening ? 'Close' : 'Open'} ${title}`;
      if (opening) {
        requestAnimationFrame(() => {
          if (frame.hidden) return;
          frame.closest('.box')?.scrollIntoView({
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
            block: 'start',
          });
        });
      }
    });
  });

  const date = document.querySelector<HTMLTimeElement>('#date');
  const clock = document.querySelector<HTMLTimeElement>('#clock');
  function updateClock() {
    const now = new Date();
    if (date && clock) {
      const locale = document.documentElement.lang === 'es' ? 'es-US' : 'en-US';
      date.textContent = now.toLocaleDateString(locale, {
        weekday: 'long', month: 'long', day: 'numeric', year: 'numeric',
      });
      clock.textContent = now.toLocaleTimeString(locale, {
        hour: '2-digit', minute: '2-digit',
      });
      date.dateTime = clock.dateTime = now.toISOString();
    }
  }
  updateClock();
  window.addEventListener('languagechange', updateClock);
  window.setInterval(updateClock, 1000);
</script>

<style>

  a
  {
    color:black;
  }
  a:hover
  {
    color:blue;
  }
  a:visited
  {
    color:#777f73;
  }
  #homepage-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      #e2eff6 0%,
      #edf3f6 45%,
      #f5f6f7 100%
    );
  }
  .hub {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(16px, 3vw, 40px);
    background: transparent;
    color: #242724;
    font-family: Arial, Helvetica, sans-serif;
  }
  header, footer {
    border: 1px solid #d9dcd6;
    background: #fff;
    border-radius: 12px;
    padding: 24px;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: clamp(14px, 1.5vw, 20px);
  }
  #clock { font-variant-numeric: tabular-nums; }
  main {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 20px;
  }
  .box {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #d9e1e6;
    border-radius: 12px;
    background: #fff;
    color: #242724;
    scroll-margin-top: 20px;
  }
  .card-content {
    box-sizing: border-box;
    height: 100%;
    min-height: 210px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .card-content h2 {
    margin: 0 0 10px;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
  }
  .card-description {
    white-space: pre-line;
    margin: 0 0 24px;
    color: #59656e;
    font-size: 14px;
    line-height: 1.5;
  }
  .card-actions {
    min-height: 80px;
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .load-frame, .card-action {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid #596650;
    border-radius: 8px;
    background: #f5f5f3;
    color: #242724;
    font: 600 14px/1.4 Arial, Helvetica, sans-serif;
    text-decoration: none;
    cursor: pointer;
  }
  .load-frame:hover, .card-action:hover {
    background: #e7ebe3;
    color: #242724;
  }
  .source-link { font-size: 13px; text-underline-offset: 3px; }
  a:focus-visible, button:focus-visible {
    outline: 3px solid #426b88;
    outline-offset: 4px;
  }
  .box.is-expanded { order: 1; grid-column: 1 / -1; }
  .box.is-expanded .card-content { height: auto; min-height: 0; }
  .box iframe {
    display: block;
    width: 100%;
    height: clamp(360px, 65vh, 800px);
    min-height: 360px;
    border: 0;
    border-top: 1px solid #d9e1e6;
  }
  .box iframe[hidden] { display: none; }
  @media (min-width: 1200px) {
    main { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .card-content { padding: 20px; }
    .card-actions { align-items: flex-start; flex-direction: column; }
    .box.is-expanded .card-actions { flex-direction: row; align-items: center; }
  }
  @media (max-width: 767px) {
    main { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  }
  footer { font-size: 14px; }
  footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 32px;
  }
  footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-underline-offset: 4px;
    line-height: 1.5;
  }

  /* Home-only palette and ridgeline inspired by the county flag. */
  #homepage-background.mountain-background {
    background: linear-gradient(180deg, #123b56 0, #214c65 440px, #e5edf0 440px, #f4f6f5 100%);
  }
  .mountain-home { color: #153c55; gap: 24px; }
  .mountain-home header {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 32px 32px 205px;
    border: 1px solid #527287;
    border-top: 4px solid #c5a13a;
    border-radius: 16px;
    background: #103750;
    color: #fff;
    box-shadow: 0 12px 32px #071f3226;
  }
  .mountain-home header::after {
    content: '★  ★  ★  ★  ★';
    position: absolute;
    bottom: 155px;
    left: 50%;
    transform: translateX(-50%);
    color: #d7b54e;
    font-size: 22px;
    letter-spacing: 8px;
    white-space: nowrap;
    z-index: -1;
  }
  .mountain-range {
    position: absolute;
    z-index: -1;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 190px;
    pointer-events: none;
  }
  .mountain-home h1 { margin: 0; font-size: clamp(30px, 4vw, 48px); letter-spacing: -1.5px; }
  .mountain-home h1 :global(.brand) { text-decoration: none; }
  .mountain-home #date, .mountain-home #clock { color: #e5edf0; font-size: 15px; }
  .mountain-home :global(.conditions) {
    padding: 16px 20px;
    border: 1px solid #58768a;
    border-radius: 10px;
    background: #20465e;
    color: #fff;
  }
  .mountain-home :global(.conditions dt), .mountain-home :global(.conditions small) { color: #dbe7ee; }
  .mountain-home .box {
    border-color: #cbd9e0;
    border-top: 3px solid #c5a13a;
    background: #fff;
    color: #153c55;
    box-shadow: 0 5px 16px #123b5609;
  }
  .mountain-home .card-description { color: #4c6372; }
  .mountain-home .load-frame, .mountain-home .card-action {
    border-color: #b9962d;
    background: #d7b54e;
    color: #102f45;
  }
  .mountain-home .load-frame:hover, .mountain-home .card-action:hover {
    background: #e8c968;
    border-color: #d7b54e;
    color: #102f45;
  }
  .mountain-home .source-link, .mountain-home .source-link:visited { color: #244e68; }
  .mountain-home footer { background: #103750; border-color: #103750; border-bottom: 3px solid #c5a13a; }
  .mountain-home footer a, .mountain-home footer a:visited { color: #f8faf9; }
  .mountain-home footer a:hover { color: #e8c968; }
  .mountain-home a:focus-visible, .mountain-home button:focus-visible { outline-color: #b58b16; }
  :global(body:has(.mountain-home) .top-bar) { background: #f8faf9; border-bottom-color: #c5a13a; }
  :global(body:has(.mountain-home) .slogan) { color: #153c55; }
  :global(body:has(.mountain-home) .language-bar button) { border-color: #8b9faa; color: #153c55; }
  :global(body:has(.mountain-home) .language-bar button[aria-pressed='true']) { background: #153c55; color: #fff; border-color: #153c55; }
  @media (max-width: 767px) {
    .mountain-home header { padding: 24px 20px 185px; gap: 18px; }
    .mountain-home h1 { flex-basis: 100%; }
    .mountain-home :global(.conditions) { width: 100%; box-sizing: border-box; }
    .mountain-range { height: 165px; }
    .mountain-home header::after { bottom: 140px; font-size: 16px; letter-spacing: 5px; }
  }
</style>

